<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 주소창 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/shield"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_on"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="VPN ON"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/url"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/url_bg"
                android:hint="주소 또는 검색어"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/reload"
                style="@style/BarButton"
                android:text="⟳" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/bar" />

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 하단 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/back" style="@style/BottomButton" android:text="◀" />
            <TextView android:id="@+id/forward" style="@style/BottomButton" android:text="▶" />
            <TextView android:id="@+id/home" style="@style/BottomButton" android:text="⌂" />
            <TextView android:id="@+id/videos" style="@style/BottomButton" android:text="⬇" />
            <TextView android:id="@+id/menu" style="@style/BottomButton" android:text="⋮" />
        </LinearLayout>
    </LinearLayout>

    <!-- 동영상 전체화면 -->
    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
